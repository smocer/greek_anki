    {
      "id": "oct16-difficult",
      "collection": "words-adjectives",
      "greek": "δύσκολο",
      "prompt": {
        "en": "Difficult",
        "ru": "Трудный",
        "zh": "困难的"
      },
      "pronunciation": {
        "en": "DHIS-ko-lo",
        "ru": "ДИС-ко-ло",
        "zh": "DHIS-ko-lo"
      },
      "labels": [
        "adjective"
      ],
      "themes": [
        "conversation"
      ],
      "reviewIdentity": {
        "deckId": "words-descriptions",
        "cardId": "oct16-difficult"
      },
      "explanation": {
        "en": "Δύσκολος, δύσκολη and δύσκολο mean difficult. The ending agrees with the noun: Το μάθημα είναι δύσκολο — The lesson is difficult.",
        "ru": "Δύσκολος, δύσκολη, δύσκολο — «трудный». Форма зависит от рода греческого существительного: το μάθημα είναι δύσκολο — «урок трудный». В греческом μάθημα среднего рода, поэтому δύσκολο. В ответе принимаются все три родовые формы.",
        "zh": "形容词 δύσκολος、δύσκολη、δύσκολο 都表示“困难的”，分别为阳性、阴性、中性。词尾与名词一致，如 Το μάθημα είναι δύσκολο.（这节课很难。）本词卡接受这三种形式。"
      }
